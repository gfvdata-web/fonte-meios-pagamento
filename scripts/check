#!/usr/bin/env bash
# Checagem do repo. Sem argumento: tudo. Com um arquivo: só o que vale para ele.
# Silencioso quando passa; sai com 1 e uma mensagem curta quando falha.
# Sem rede, sem tokens, sem navegador: a API do BCB é substituída por tests/fixtures/.
# Chamado pelo hook global (~/.claude/hooks/run-check.sh) depois de cada edição e
# pelo .githooks/pre-commit (modo completo) antes de cada commit.
#
# Cobertura (cada linha tem teste; "(sem teste: motivo)" onde não dá sem rede/navegador):
#   Pipeline (run_pipeline.py, src/)                                   tests/test_pipeline.py
#     Etapa 2 coleta  (API Olinda mockada; erro HTTP não apaga o bruto)
#     Etapa 3 tratamento wide -> tidy (AnoMes, zeros, forma ausente, texto/nulo)
#     Etapa 4 análise (YoY, CAGR, ticket, ranking, estatística descritiva)
#     Etapa 5 publicação (JSON do painel + CSV público) e empacotamento da skill (zip)
#     Etapa E perfil (3 tabelas, chave, joins, cobertura, tabela auxiliar de formas)
#     run_pipeline.py de ponta a ponta + flags --sem-coleta/--sem-perfil, sem tocar no repo
#   Contrato página <-> dados publicados em docs/dados/               tests/test_contrato_dados.py
#     meios_pagamento_mensal.json/.csv (campos do app-v2.js), eventos_*.json,
#     perfil_*.json e notas_*.json (campos do explorar.js, selos do CSS, filtros da pauta)
#   Páginas: index.html (painel), explorar.html, skill.html           tests/test_paginas.py
#     css/js com ?v=hash (scripts/versionar_assets.py, rodado pelo .githooks/pre-commit)
#     links locais, ids x JS, abas/subabas, períodos, navegação, tema claro/escuro, GoatCounter com prefixo,
#     instalação da skill (3 passos, botão do zip, tamanho anunciado, CSV alternativo)
#   JS das páginas (app-v2.js, explorar.js) com DOM falso             tests/js/paginas.test.js
#     formatação, períodos, granularidade, participação 100%, CAGR/ticket = Python,
#     narrativas, eventos, renderização da exploração com perfil+notas reais
#   Sintaxe: .py, JSON, CSV, node --check (docs/js, tests/js, <script> inline)   tests/test_sintaxe.py
#   Catálogo de séries: src/config.py x catalogo/fonte.md x DECLARACAO do perfil tests/test_catalogo.py
#   Skill do Claude (SKILL.md, carregar_dados.py offline, zip em dia)  tests/test_skill.py
#   Etapa 7: workflow atualizacao-mensal.yml, descartar_mudancas_cosmeticas.py, requirements  tests/test_automacao.py
#   Contador de downloads (cloudflare/contagem.mjs + functions/_middleware.js) com D1 falso  tests/js/contagem.test.js
#     zip/CSV contam (GET 200 sem Range), navegador/script/robô, /contagem.json, D1 fora do ar;
#     wrangler.toml, docs/_routes.json e cópia idêntica ao arrecadacao em tests/test_automacao.py
#   (sem teste: chamada real à API Olinda, CDN do Chart.js, GitHub Pages/Actions, desenho dos
#    gráficos e CSS/responsivo — exigem rede ou navegador)
cd "$(dirname "$0")/.." || exit 1
alvo="$(printf '%s' "${1:-}" | sed 's#\\#/#g')";alvo="${alvo#"$(pwd -W 2>/dev/null || pwd)/"}"; alvo="${alvo#"$(pwd)/"}"
falhas=0
export PYTHONDONTWRITEBYTECODE=1 PYTHONIOENCODING=utf-8

# Roda um comando; só mostra a saída (cortada) se falhar.
rodar() {
  local saida
  if ! saida="$("$@" 2>&1)"; then
    printf '%s\n' "$saida" | tail -40
    falhas=1
  fi
}
testes_py() { rodar python -m unittest -q "$@"; }
testes_js() { rodar node --test tests/js/*.test.js; }

case "$alvo" in
  "")
    rodar python -m unittest discover -q -s tests -t .
    testes_js
    ;;
  src/*.py|run_pipeline.py) testes_py tests.test_pipeline tests.test_catalogo tests.test_sintaxe ;;
  tests/js/*.js)            testes_js; rodar node --check "$alvo" ;;
  tests/fixtures/*)         testes_py tests.test_pipeline tests.test_skill tests.test_sintaxe ;;
  tests/test_*.py)          m="${alvo%.py}"; testes_py "${m//\//.}" ;;
  tests/*.py)               testes_py tests.test_sintaxe ;;
  .github/*)                testes_py tests.test_automacao tests.test_sintaxe ;;
  skill/*)                  testes_py tests.test_skill tests.test_sintaxe ;;
  cloudflare/*|functions/*|wrangler.toml|docs/_routes.json) testes_js; testes_py tests.test_automacao ;;
  catalogo/*)               testes_py tests.test_catalogo ;;
  scripts/*.py|.githooks/*) testes_py tests.test_paginas tests.test_sintaxe ;;
  requirements.txt)         testes_py tests.test_automacao ;;
  docs/js/*.js)             rodar node --check "$alvo"; testes_js; testes_py tests.test_paginas tests.test_contrato_dados ;;
  docs/dados/*)             testes_py tests.test_contrato_dados tests.test_sintaxe tests.test_skill tests.test_pipeline.TestPipelineCompleto ;;
  docs/skill/*)             testes_py tests.test_skill tests.test_paginas ;;
  docs/*.html|docs/css/*)   testes_py tests.test_paginas tests.test_sintaxe tests.test_contrato_dados ;;
  *)                        : ;;
esac
exit $falhas
